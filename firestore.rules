rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    // 직원 정보는 인증 후에만 조회하고 계정 생성/수정은 Cloud Functions에서만 수행합니다.
    match /employees/{employeeId} {
      allow get: if signedIn() && (employeeId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    match /usernames/{username} {
      allow read, write: if false;
    }

    match /employeeEmails/{emailHash} {
      allow read, write: if false;
    }

    match /leaves/{leaveId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /leave_history/{historyId} {
      allow read: if isAdmin();
      allow write: if false;

      match /logs/{logId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
